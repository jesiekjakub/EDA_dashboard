# Copy this file to `.env` to override Compose defaults.
#
# Kaggle credentials are NOT taken from .env — the fetcher service
# bind-mounts ~/.kaggle/ from the host instead, so any of the
# Kaggle-supported auth methods work (kaggle.json, access_token, ...).

# Host port the dashboard is exposed on.
SHINY_PORT=3838

# Per-worker R memory cap. Bump if plotly serialization OOMs on a large
# filtered subset.
R_MAX_VSIZE=4Gb
